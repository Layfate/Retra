<?xml version="1.0" encoding="utf-8"?>
<!-- Retra controller face: light gray face #FFD4D7DB on a #FF8F959C rim that
     sits 2.5dp below it; pressed sinks the face onto the rim (#FFA9AEB5).
     Translucency comes from the Buttons opacity setting (view alpha). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="90">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="2.5dp">
                <shape android:shape="oval">
                    <solid android:color="#FF8F959C" />
                </shape>
            </item>
            <item android:top="2dp" android:bottom="0.5dp">
                <shape android:shape="oval">
                    <solid android:color="#FFA9AEB5" />
                    <stroke android:width="1dp" android:color="#FFEEF0F2" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="2.5dp">
                <shape android:shape="oval">
                    <solid android:color="#FF8F959C" />
                </shape>
            </item>
            <item android:bottom="2.5dp">
                <shape android:shape="oval">
                    <solid android:color="#FFD4D7DB" />
                    <stroke android:width="1dp" android:color="#FFEEF0F2" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
